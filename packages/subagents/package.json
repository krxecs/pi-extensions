{
  "name": "@pixt/subagents",
  "version": "0.0.1",
  "description": "Pi RPC coding child feasibility baseline",
  "repository": { "type": "git", "url": "https://github.com/krxecs/pi-extensions" },
  "type": "module",
  "keywords": ["pi-package", "pi-extension", "subagents"],
  "license": "MIT",
  "engines": { "node": ">=20" },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": ["dist", "src"],
  "exports": { ".": { "types": "./dist/index.d.mts", "import": "./dist/index.mjs" } },
  "publishConfig": { "access": "public" },
  "pi": { "extensions": ["./src/index.ts"] },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.7.0",
    "@earendil-works/pi-coding-agent": "1.7.0",
    "@earendil-works/pi-tui": "1.7.0",
    "@gotgenes/pi-subagents": "25.0.5",
    "@types/node": "^26.1.1",
    "tsdown": "^0.22.8",
    "typebox": "1.3.27",
    "typescript": "^7.0.2"
  }
}
