{
  "name": "@pixt/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Personal Pi extensions monorepo (pnpm workspaces)",
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.5.0 <27",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.16.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "typecheck": "pnpm -r --filter \"./packages/*\" run typecheck",
    "lint": "biome check .",
    "lint:ci": "biome ci",
    "format": "biome format --write .",
    "release": "pnpm build && pnpm publish -r --provenance --report-summary"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "typescript": "^7.0.2"
  }
}
